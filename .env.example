# App Config
APP_ENV=dev
APP_PORT=8000
APP_HOST=0.0.0.0

# LLM API Config
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=financial_blocks

# SQLite Financial Facts Database
SQLITE_DB_PATH=data/financial_reports.db

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
